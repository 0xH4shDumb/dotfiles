layout {
    gaps 14
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        on
        draw-behind-window false
        softness 0
        spread 4
        offset x=0 y=0
        color "#ff66cc"
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    background-color "transparent"
}
