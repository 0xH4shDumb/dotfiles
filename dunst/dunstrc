[global]
    monitor = 0
    follow = none
    width = 320
    height = (0, 300)
    origin = top-right
    offset = (20, 20)
    scale = 0
    notification_limit = 5
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    corner_radius = 12
    corners = all
    gap_size = 6
    separator_color = frame
    sort = yes

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#2f2f2fdd"
    foreground = "#e8dfeb"
    frame_color = "#5c5560cc"
    timeout = 8

[urgency_normal]
    background = "#2f2f2fdd"
    foreground = "#e8dfeb"
    frame_color = "#ff66cccc"
    timeout = 10

[urgency_critical]
    background = "#2f2f2fdd"
    foreground = "#e8dfeb"
    frame_color = "#ff2e63cc"
    timeout = 0
